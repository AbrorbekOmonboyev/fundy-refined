# Copy this file to .env.local and fill in the values.
# Only variables starting with VITE_ reach the browser — never put secret keys in them.

# Supabase → Project Settings → API Keys
#   URL:             https://<project-ref>.supabase.co
#   Publishable key: starts with sb_publishable_  (safe for the browser; security comes from the database rules)
# Never use the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: error tracking. Sentry → Project → Client Keys (DSN). Leave empty to switch it off.
VITE_SENTRY_DSN=

# Optional: Telegram notifications bot username (without @), e.g. FundyUzBot.
# Leave empty to hide "Connect Telegram" in Settings. The bot token itself is a
# Supabase Edge Function secret (TELEGRAM_BOT_TOKEN), never a VITE_ variable.
VITE_TELEGRAM_BOT=

# Optional: OneID identity check (docs/ONEID.md). Set to true only after the oneid
# edge function has its OneID secrets. Leave empty to show "Coming soon".
VITE_ONEID_ENABLED=
